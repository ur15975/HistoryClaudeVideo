# Gemini（TTS 配音 + Lyria 配乐）。在 https://aistudio.google.com/apikey 获取
GEMINI_API_KEY=

# Claude（可选：用 `npm run write -- "主题"` 自动写剧本时需要）
ANTHROPIC_API_KEY=

# 可选：覆盖默认模型
# HCV_TTS_MODEL=gemini-3.8-flash-tts
# HCV_MUSIC_MODEL=lyria-3-pro-preview
# HCV_CLAUDE_MODEL=claude-opus-5-5

# 可选：指定 Chromium 可执行文件（默认使用 Playwright 自带浏览器）
# CHROMIUM_PATH=
